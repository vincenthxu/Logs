@page "/entry"
@page "/entry/{Id:int}"
@rendermode InteractiveServer
@inject Client client
@inject SessionState session
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations

<FluentGrid>
    <FluentCard>
        <FluentEditForm Model="@entryModel">
            <FluentDatePicker Required="true" @bind-Value="entryModel.Date" Label="Date" DisabledDateFunc="DisabledDay" />
            <FluentTimePicker Required="true" @bind-Value="entryModel.Time" Label="Time" />
            <FluentSlider @bind-Value="entryModel.BristolStoolScale" Label="Bristol Stool Scale" Min="1" Max="7" Step="1" />
            <FluentTextArea @bind-Value="entryModel.Notes" Label="Notes" />
        </FluentEditForm>
        <FluentButton OnClick="handleSave">Save</FluentButton>
        <FluentAnchor Href="/">Cancel</FluentAnchor>
    </FluentCard>
</FluentGrid>

@code {
    [Parameter]
    public int? Id { get; set; }

    private EntryViewModel entryModel = new();

    private async Task handleSave()
    {
        var entry = new Entry()
        {
            UserId = session.CurrentUser.Id,
            Date = DateOnly.FromDateTime(entryModel.Date.Value),
            Time = TimeOnly.FromDateTime(entryModel.Time.Value),
            BristolStoolScale = (BristolStoolScale)(entryModel.BristolStoolScale),
            Notes = entryModel.Notes
        };

        if (Id.HasValue)
        {
            entry.Id = Id.Value;
            await client.EntriesPUTAsync(entry.Id, entry);
        }
        else
        {
            await client.EntriesPOSTAsync(entry);
        }
        Navigation.NavigateTo("/");
    }

    private bool DisabledDay(DateTime day)
    {
        return day > DateTime.Now;
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (!session.IsLoggedIn)
        {
            Navigation.NavigateTo("/signin");
        }

        if (Id.HasValue)
        {
            var entry = await client.EntriesGETAsync(Id.Value);
            entryModel.Date = entry.Date.ToDateTime(entry.Time);
            entryModel.Time = entryModel.Date;
            entryModel.BristolStoolScale = (int)(entry.BristolStoolScale);
            entryModel.Notes = entry.Notes;
        }
    }

    public class EntryViewModel
    {
        [Required(ErrorMessage = "Date is required")]
        public DateTime? Date { get; set; } = DateTime.Now;

        [Required(ErrorMessage = "Time is required")]
        public DateTime? Time { get; set; } = DateTime.Now;

        [Required(ErrorMessage = "Bristol Stool Scale is required")]
        public int BristolStoolScale { get; set; }

        public Guid UserId { get; set; }

        public string? Notes { get; set; }
    }
}