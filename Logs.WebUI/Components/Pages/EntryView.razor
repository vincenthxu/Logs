@page "/entry"
@page "/entry/{Id:int}"
@inject Client client
@* @inject SessionState session *@
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations

<FluentCard Style="display:flex; justify-content: center; align-items: center">
    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
        <EditForm Model="@entryModel">
            <FluentDatePicker Required="true" @bind-Value="entryModel.Date" Label="Date" DisabledDateFunc="DisabledDay" Style="width:100%" />
            <FluentTimePicker Required="true" @bind-Value="entryModel.Time" Label="Time" Style="width:100%" />
            <FluentSlider @bind-Value="entryModel.BristolStoolScale" Label="Bristol Stool Scale" Min="1" Max="7" Step="1" Style="margin-bottom: 50px">
                <FluentSliderLabel Position="1">1</FluentSliderLabel>
                <FluentSliderLabel Position="2">2</FluentSliderLabel>
                <FluentSliderLabel Position="3">3</FluentSliderLabel>
                <FluentSliderLabel Position="4">4</FluentSliderLabel>
                <FluentSliderLabel Position="5">5</FluentSliderLabel>
                <FluentSliderLabel Position="6">6</FluentSliderLabel>
                <FluentSliderLabel Position="7">7</FluentSliderLabel>
            </FluentSlider>
            <FluentTextArea @bind-Value="entryModel.Notes" Label="Notes" Style="width:100%" />
            <FluentButton OnClick="handleSave" Style="width:100%">Save</FluentButton>
            <FluentAnchor Href="/" Style="width:100%">Cancel</FluentAnchor>
        </EditForm>
    </FluentStack>
</FluentCard>

@code {
    [Parameter]
    public int? Id { get; set; }

    private EntryViewModel entryModel = new();

    private async Task handleSave()
    {
        var entry = new Entry()
        {
            UserId = client.User.Id,
            Date = DateOnly.FromDateTime(entryModel.Date.Value),
            Time = TimeOnly.FromDateTime(entryModel.Time.Value),
            BristolStoolScale = (BristolStoolScale)(entryModel.BristolStoolScale),
            Notes = entryModel.Notes
        };

        if (Id.HasValue)
        {
            entry.Id = Id.Value;
            await client.EntriesPUTAsync(entry.Id, entry);
        }
        else
        {
            await client.EntriesPOSTAsync(entry);
        }
        Navigation.NavigateTo("/");
    }

    private bool DisabledDay(DateTime day)
    {
        return day > DateTime.Now;
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (!client.IsLoggedIn)
        {
            Navigation.NavigateTo("/signin");
        }

        if (Id.HasValue)
        {
            var entry = await client.EntriesGETAsync(Id.Value);
            entryModel.Date = entry.Date.ToDateTime(entry.Time);
            entryModel.Time = entryModel.Date;
            entryModel.BristolStoolScale = (int)(entry.BristolStoolScale);
            entryModel.Notes = entry.Notes;
        }
    }

    public class EntryViewModel
    {
        [Required(ErrorMessage = "Date is required")]
        public DateTime? Date { get; set; } = DateTime.Now;

        [Required(ErrorMessage = "Time is required")]
        public DateTime? Time { get; set; } = DateTime.Now;

        [Required(ErrorMessage = "Bristol Stool Scale is required")]
        public int BristolStoolScale { get; set; }

        public Guid UserId { get; set; }

        public string? Notes { get; set; }
    }
}