@page "/signup"
@inject Client client
@* @inject SessionState session *@
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations

<FluentCard Style="display:flex; justify-content: center; align-items: center">

    <EditForm FormName="SignupForm" Model="@userModel" OnValidSubmit="HandleValidSubmit" style="width: 400px">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <FluentStack Orientation=Orientation.Vertical HorizontalAlignment="HorizontalAlignment.Center">
            <h1>Sign up</h1>
            <div style="width:75%">
                <FluentTextField @bind-Value=userModel.Name Label="Name" Required="true" Style="width:100%" />
                <FluentTextField @bind-Value=userModel.Email Label="Email" Required="true" TextFieldType="TextFieldType.Email" Style="width:100%" />
                <FluentTextField @bind-Value=userModel.Password Label="Password" Required="true" TextFieldType="TextFieldType.Password" Style="width:100%" />
                <FluentDatePicker @bind-Value=userModel.DateOfBirth Label="Date of birth" Required="true" DisabledDateFunc="DisabledDay" Style="width: 100%" />
            </div>

            <FluentButton Type="ButtonType.Submit" Style="margin-top:10px;">Sign Up</FluentButton>

            <FluentDivider Style="width: 100%;" Role="DividerRole.Separator"></FluentDivider>

            Have an account?

            <FluentNavLink Href="signin">Sign In</FluentNavLink>

            @if (successMessage != null)
            {
                <h3 Style="color:green; margin-top:10px;">
                    @successMessage
                </h3>
            }
            @if (errorMessage != null)
            {
                <h3 Style="color:red; margin-top:10px;">
                    @errorMessage
                </h3>
            }
        </FluentStack>

    </EditForm>
</FluentCard>

@code {
    private UserModel userModel = new();
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (client.IsLoggedIn)
        {
            Navigation.NavigateTo("/");
        }
        await base.OnInitializedAsync();
    }

    private async Task HandleValidSubmit()
    {
        successMessage = null;
        errorMessage = null;

        try
        {
            await client.RegisterAsync(
                new RegisterRequest()
                {
                    Email = userModel.Email,
                    Password = userModel.Password
                }
            );

            await client.UsersPOSTAsync(
                new User()
                {
                    Name = userModel.Name,
                    Email = userModel.Email,
                    DateOfBirth = DateOnly.FromDateTime(userModel.DateOfBirth ?? DateTime.Today),
                }
            );
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
            errorMessage = $"{userModel.Email} is already registered!";
            return;
        }

        successMessage = $"Welcome, {userModel.Name}! Your account has been created.";
    }

    private bool DisabledDay(DateTime date) => date > DateTime.Today;

    public class UserModel
    {
        [Required(ErrorMessage = "Name is required")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string? Password { get; set; }

        [Required(ErrorMessage = "Date of birth is required")]
        public DateTime? DateOfBirth { get; set; } = DateTime.Now;
    }
}