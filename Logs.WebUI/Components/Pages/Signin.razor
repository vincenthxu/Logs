@page "/signin"
@inject Client client
@* @inject SessionState session *@
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations

<FluentCard Style="display:flex; justify-content: center; align-items: center">

    <EditForm FormName="SigninForm" Model="@userModel" OnValidSubmit="HandleValidSubmit" style="overflow:visible; width:400px">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <FluentStack Orientation=Orientation.Vertical HorizontalAlignment="HorizontalAlignment.Center">
            <h1>Sign in</h1>
            <div style="width: 75%">
                <FluentTextField @bind-Value=userModel.Email Label="Email" Required="true" TextFieldType="TextFieldType.Email" Style="width:100%" />
                <FluentTextField @bind-Value=userModel.Password Label="Password" Required="true" TextFieldType="TextFieldType.Password" Style="width:100%" />
            </div>

            <FluentButton Type="ButtonType.Submit" Style="margin-top:10px;">Sign In</FluentButton>

            <FluentDivider Style="width: 100%;" Role="DividerRole.Separator"></FluentDivider>

            Need an account?

            <FluentNavLink Href="signup">Sign Up</FluentNavLink>

            @if (signinErrorMessage != null)
            {
                <FluentNavLink href="/signup">
                    <h3 Style="color:red; margin-top:10px;">
                        @signinErrorMessage
                    </h3>
                </FluentNavLink>
            }
        </FluentStack>

    </EditForm>
</FluentCard>

@code {
    private UserModel userModel = new();

    private string? signinErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (client.IsLoggedIn)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            var response = await client.LoginAsync(
            false,
            false,
            new LoginRequest()
            {
                Email = userModel.Email,
                Password = userModel.Password,
                TwoFactorCode = "",
                TwoFactorRecoveryCode = ""
            });

            client.SetBearerToken(response.AccessToken);

            client.SetUser(await client.UsersGETByEmailAsync(userModel.Email));

            Navigation.NavigateTo("/");
        }
        catch (ApiException)
        {
            signinErrorMessage = "Invalid login. Have you signed up?";
        }
    }

    public class UserModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string? Password { get; set; }
    }
}